# C++ build files
*.o
*.obj
*.dll
*.so
*.a
*.lib
*.pdb
*.ilk
*.exp
*.map
*.pch
*.gch
*.ncb
*.suo

# Build directories
build/
bin/
obj/
Debug/
Release/

# User-specific files
*.user
*.userprefs

# IDE files
.vscode/
.idea/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# --- Project-specifieke bestanden negeren ---

# Negeer alle uitvoerbare bestanden in de root directory
# (bijv. een oude output.exe of test.exe)
/*.exe

# Negeer de inhoud van de input en output mappen,
# maar behoud de mappen zelf in de repository.
/input/*
/output/*

# Maak een uitzondering voor de .gitkeep bestanden,
# zodat de mappen altijd zichtbaar zijn.
!/input/.gitkeep
!/output/.gitkeep
