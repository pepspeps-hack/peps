<style>
.social-media-links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  gap: 15px; /* Ruimte tussen iconen */
}

.social-media-links li a {
  display: inline-block;
  color: var(--color-text); /* Gebruik de standaard tekstkleur */
  text-decoration: none;
}

.social-media-links .icon {
  width: 24px; /* Standaardgrootte voor iconen */
  height: 24px;
  fill: currentColor; /* Zorgt ervoor dat de SVG de kleur van de 'a' tag erft */
  transition: opacity 0.3s ease;
}

.social-media-links li a:hover .icon {
  opacity: 0.7; /* Subtiel hover effect */
}
</style>
