<div class="page-width">
  {% if cart.item_count > 0 %}
    <div class="section-header text-center">
      <h1>{{ 'cart.general.title' | t }}</h1>
    </div>

    <form action="{{ routes.cart_url }}" method="post" novalidate class="cart">
      <table>
        <thead class="cart__row cart__row--heading">
          <th colspan="2" scope="col">{{ 'cart.label.product' | t }}</th>
          <th scope="col">{{ 'cart.label.price' | t }}</th>
          <th scope="col" class="text-center">{{ 'cart.label.quantity' | t }}</th>
          <th scope="col" class="text-right">{{ 'cart.label.total' | t }}</th>
        </thead>
        <tbody>
          {% for item in cart.items %}
            <tr class="cart__row" data-line="{{ forloop.index }}">
              <td class="cart__image-wrapper">
                <a href="{{ item.url | within: collections.all }}">
                  <img class="cart__image" src="{{ item | img_url: 'small' }}" alt="{{ item.title | escape }}">
                </a>
              </td>
              <td class="cart__meta">
                <a href="{{ item.url }}" class="cart__product-title">{{ item.product.title }}</a>
                {% unless item.variant.title contains 'Default' %}
                  <p class="cart__variant-title">{{ item.variant.title }}</p>
                {% endunless %}

                {% comment %} Toon eventuele line item properties hier {% endcomment %}
                {% assign property_size = item.properties | size %}
                {% if property_size > 0 %}
                  {% for p in item.properties %}
                    {% assign first_character_in_key = p.first | truncate: 1, '' %}
                    {% unless p.last == blank or first_character_in_key == '_' %}
                      {{ p.first }}:
                      {% if p.last contains '/uploads/' %}
                        <a href="{{ p.last }}">{{ p.last | split: '/' | last }}</a>
                      {% else %}
                        {{ p.last }}
                      {% endif %}
                      <br>
                    {% endunless %}
                  {% endfor %}
                {% endif %}

                <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity=0" class="cart__remove">
                  <small>{{ 'cart.general.remove' | t }}</small>
                </a>
              </td>
              <td class="cart__price text-right">
                {{ item.price | money }}
              </td>
              <td class="cart__quantity text-center">
                <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" data-line="{{ forloop.index }}" class="cart__quantity-selector">
              </td>
              <td class="cart__line-price text-right">
                {{ item.final_line_price | money }}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <div class="cart__footer">
        <div class="grid">
          <div class="grid__item medium-up--one-half cart-note">
            <label for="CartSpecialInstructions">{{ 'cart.general.note' | t }}</label>
            <textarea name="note" id="CartSpecialInstructions" class="cart-note__input">{{ cart.note }}</textarea>
          </div>
          <div class="grid__item medium-up--one-half text-right">
            <p>
              <span class="cart__subtotal">{{ 'cart.general.subtotal' | t }}</span>
              <span class="cart__subtotal-price">{{ cart.total_price | money }}</span>
            </p>
            <p class="cart__shipping"><em>{{ 'cart.general.shipping_at_checkout' | t }}</em></p>
            <button type="submit" name="update" class="btn btn--secondary cart__update-button">{{ 'cart.general.update' | t }}</button>
            <button type="submit" name="checkout" class="btn btn--primary cart__checkout-button">{{ 'cart.general.checkout' | t }}</button>

            {% if additional_checkout_buttons %}
              <div class="additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>
            {% endif %}
          </div>
        </div>
      </div>
    </form>
  {% else %}
    <div class="section-header text-center">
      <h1>{{ 'cart.general.title' | t }}</h1>
    </div>
    <p class="text-center">{{ 'cart.general.empty' | t }}</p>
    <p class="text-center">{{ 'cart.general.continue_browsing_html' | t: url: routes.all_products_collection_url }}</p>
  {% endif %}
</div>

<style>
/* Stijlen voor de winkelwagenpagina */
.cart table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 30px;
}
.cart th, .cart td {
  padding: 15px;
  border-bottom: 1px solid #eee;
  text-align: left;
}
.cart th {
  font-weight: bold;
  background-color: #f9f9f9;
}
.cart__image-wrapper {
  width: 100px; /* Vaste breedte voor de afbeelding kolom */
}
.cart__image {
  max-width: 80px;
  height: auto;
  border: 1px solid #eee;
}
.cart__product-title {
  font-size: 1.1em;
  font-weight: bold;
  color: #333;
  text-decoration: none;
}
.cart__product-title:hover {
  text-decoration: underline;
}
.cart__variant-title {
  font-size: 0.9em;
  color: #666;
  margin-top: 5px;
}
.cart__remove {
  font-size: 0.9em;
  color: #d9534f;
  text-decoration: none;
  display: inline-block;
  margin-top: 8px;
}
.cart__remove:hover {
  text-decoration: underline;
}
.cart__quantity-selector {
  width: 60px;
  padding: 8px;
  text-align: center;
  border: 1px solid #ccc;
  border-radius: 4px;
}
.text-center {
  text-align: center;
}
.text-right {
  text-align: right;
}
.cart__footer {
  margin-top: 30px;
  padding-top: 20px;
  border-top: 1px solid #ddd;
}
.cart-note__input {
  width: 100%;
  min-height: 80px;
  padding: 10px;
  border: 1px solid #ccc;
  border-radius: 4px;
  margin-top: 5px;
}
.cart__subtotal {
  font-size: 1.2em;
}
.cart__subtotal-price {
  font-size: 1.2em;
  font-weight: bold;
  margin-left: 10px;
}
.cart__shipping {
  font-size: 0.9em;
  color: #777;
  margin-bottom: 15px;
}
.cart__update-button, .cart__checkout-button {
  /* Gebruik .button-primary of .button-secondary stijlen */
  padding: 12px 20px;
  text-decoration: none;
  border: none;
  cursor: pointer;
  transition: background-color 0.3s ease;
  font-size: 1em;
  margin-left: 10px;
}
.cart__update-button {
  background-color: #777; /* Voorbeeld secundaire knop */
  color: #fff;
}
.cart__update-button:hover {
  background-color: #555;
}
.cart__checkout-button {
  background-color: #000; /* Primaire actie knop */
  color: #fff;
}
.cart__checkout-button:hover {
  background-color: #444;
}
.additional-checkout-buttons {
  margin-top: 15px;
}
/* Grid voor footer layout */
.grid {
  display: flex;
  flex-wrap: wrap;
  margin-left: -15px;
  margin-right: -15px;
}
.grid__item {
  padding-left: 15px;
  padding-right: 15px;
  box-sizing: border-box;
  width: 100%; /* Standaard voor mobiel */
}
@media screen and (min-width: 750px) { /* Medium-up breakpoint */
  .grid__item.medium-up--one-half {
    width: 50%;
  }
}
</style>

<script>
// Kleine JS voor cart updates zonder volledige pagina herlaad (optioneel, kan complex zijn)
document.addEventListener('DOMContentLoaded', function() {
  const quantityInputs = document.querySelectorAll('.cart__quantity-selector');
  const updateButton = document.querySelector('button[name="update"]');

  quantityInputs.forEach(input => {
    input.addEventListener('change', function() {
      // Toon de update knop als deze verborgen was, of geef een hint
      if (updateButton) {
        // Je zou hier de knop duidelijker kunnen maken of een bericht tonen
        // Voor nu, gaan we ervan uit dat de gebruiker op "Update" of "Checkout" klikt
      }
    });
  });
});
</script>
