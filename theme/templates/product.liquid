<div class="page-width">
  <div class="grid product-single">
    <div class="grid__item medium-up--one-half">
      {% comment %} Productafbeelding {% endcomment %}
      <div class="product-single__photo-wrapper">
        {% assign current_variant = product.selected_or_first_available_variant | default: product.variants.first %}
        {% assign featured_image = current_variant.featured_image | default: product.featured_image %}

        <div class="product-image-main">
          <img src="{{ featured_image | img_url: '1024x1024' }}" alt="{{ featured_image.alt | escape }}" id="ProductPhotoImg"
               data-zoom-url="{{ featured_image | img_url: '2048x2048' }}">
          {% comment %} Placeholder voor zoom functionaliteit, kan met JS library zoals Drift of Photoswipe {% endcomment %}
        </div>
      </div>

      {% if product.images.size > 1 %}
        <ul class="product-single__thumbnails">
          {% for image in product.images %}
            <li class="product-single__thumbnail-item {% if image == featured_image %}is-active{% endif %}" data-thumbnail-id="{{ image.id }}">
              <a href="{{ image | img_url: '1024x1024' }}" data-image-id="{{ image.id }}" class="product-single__thumbnail-link">
                <img src="{{ image | img_url: 'compact' }}" alt="{{ image.alt | escape }}">
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>

    <div class="grid__item medium-up--one-half product-single__details">
      <div class="product-single__meta">
        <h1 class="product-single__title">{{ product.title }}</h1>

        {% comment %} SKU / Vendor (optioneel) {% endcomment %}
        <div class="product-single__subheading">
            {% if product.vendor != blank %}
              <span class="product-single__vendor">{{ product.vendor }}</span>
            {% endif %}
            {% if current_variant.sku != blank %}
              <span class="product-single__sku">SKU: {{ current_variant.sku }}</span>
            {% endif %}
        </div>

        <div class="product__price product__price--single">
          <span class="product__price-value">{{ current_variant.price | money }}</span>
          {% if current_variant.compare_at_price > current_variant.price %}
            <s class="product__price--compare">{{ current_variant.compare_at_price | money }}</s>
            <span class="product__price--sale-badge">{{ 'products.product.on_sale' | t | default: 'Sale' }}</span>
          {% endif %}
        </div>

        {% comment %} Short description (optioneel, via metafield of begin van description) {% endcomment %}
        {% if product.metafields.custom.short_description != blank %}
            <div class="product-single__short-description rte">
                {{ product.metafields.custom.short_description }}
            </div>
        {% elsif product.description contains '<!-- split -->' %}
             <div class="product-single__short-description rte">
                {{ product.description | split: '<!-- split -->' | first }}
            </div>
        {% endif %}


        {% comment %} Productformulier {% endcomment %}
        {% form 'product', product, class: 'product-form' %}
          <div id="variant-json" class="hidden" data-variant-json="{{ product.variants | json | escape }}"></div>

          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              <div class="product-form__option selector-wrapper js product-form__item" data-option-index="{{ forloop.index0 }}">
                <label for="SingleOptionSelector-{{ forloop.index0 }}" class="product-form__option-name">
                  {{ option.name }}
                </label>
                <div class="product-form__option-values">
                  {% for value in option.values %}
                    <input type="radio" id="Option{{ option.position }}-{{ value | handle }}"
                           name="options[{{ option.name | escape }}]"
                           value="{{ value | escape }}"
                           {% if option.selected_value == value %}checked="checked"{% endif %}
                           data-option-value>
                    <label for="Option{{ option.position }}-{{ value | handle }}" class="product-form__option-value-label">
                      {{ value }}
                    </label>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          {% endunless %}

          <select name="id" id="ProductSelect" class="product-form__variants no-js visually-hidden">
            {% for variant in product.variants %}
              <option {% if variant == current_variant %}selected="selected"{% endif %}
                      value="{{ variant.id }}"
                      {% unless variant.available %}disabled="disabled"{% endunless %}>
                {{ variant.title }}
              </option>
            {% endfor %}
          </select>

          <div class="product-form__item product-form__item--quantity">
            <label for="Quantity-{{ product.id }}" class="visually-hidden">{{ 'products.product.quantity' | t }}</label>
            <div class="quantity-selector">
                <button type="button" class="quantity-selector__button quantity-selector__button--minus" aria-label="Decrease quantity">-</button>
                <input type="number" id="Quantity-{{ product.id }}" name="quantity" value="1" min="1" class="quantity-selector__input" aria-label="Product quantity">
                <button type="button" class="quantity-selector__button quantity-selector__button--plus" aria-label="Increase quantity">+</button>
            </div>
          </div>

          <div class="product-form__item product-form__item--submit">
            <button type="submit" name="add" class="btn btn--primary product-form__cart-submit"
                    {% unless current_variant.available %}disabled="disabled"{% endunless %}>
              <span class="add-to-cart-text">
                {% if current_variant.available %}
                  {{ 'products.product.add_to_cart' | t }}
                {% else %}
                  {{ 'products.product.sold_out' | t }}
                {% endif %}
              </span>
              <span class="product-form__spinner" style="display:none;">
                {% comment %} SVG spinner icon here {% endcomment %}
                <svg width="18" height="18" viewBox="0 0 38 38" xmlns="http://www.w3.org/2000/svg" stroke="#fff"><g fill="none" fill-rule="evenodd"><g transform="translate(1 1)" stroke-width="2"><circle stroke-opacity=".5" cx="18" cy="18" r="18"/><path d="M36 18c0-9.94-8.06-18-18-18"><animateTransform attributeName="transform" type="rotate" from="0 18 18" to="360 18 18" dur="1s" repeatCount="indefinite"/></path></g></g></svg>
              </span>
            </button>
          </div>
        {% endform %}

        {% comment %} Product Tabs: Beschrijving, Specificaties, Recensies {% endcomment %}
        <div class="product-tabs">
          <ul class="product-tabs__list" role="tablist">
            <li class="product-tabs__item" role="presentation"><a href="#tab-description" role="tab" aria-controls="tab-description" aria-selected="true" class="product-tabs__link is-active">{{ 'products.product.description' | t | default: 'Description' }}</a></li>
            {% if product.metafields.custom.specifications != blank %}
              <li class="product-tabs__item" role="presentation"><a href="#tab-specifications" role="tab" aria-controls="tab-specifications" class="product-tabs__link">{{ 'products.product.specifications' | t | default: 'Specifications' }}</a></li>
            {% endif %}
             <li class="product-tabs__item" role="presentation"><a href="#tab-reviews" role="tab" aria-controls="tab-reviews" class="product-tabs__link">{{ 'products.product.reviews' | t | default: 'Reviews' }} (<span class="product-reviews-count">0</span>)</a></li>
          </ul>

          <div id="tab-description" role="tabpanel" class="product-tabs__panel is-active rte">
            {% if product.description contains '<!-- split -->' %}
                {{ product.description | split: '<!-- split -->' | last }}
            {% else %}
                {{ product.description }}
            {% endif %}
          </div>
          {% if product.metafields.custom.specifications != blank %}
            <div id="tab-specifications" role="tabpanel" class="product-tabs__panel rte">
              {{ product.metafields.custom.specifications }}
            </div>
          {% endif %}
          <div id="tab-reviews" role="tabpanel" class="product-tabs__panel">
            {% comment %} Shopify Product Reviews app injecteert hier {% endcomment %}
            <div id="shopify-product-reviews" class="shopify-product-reviews" data-id="{{product.id}}">
              {{ product.metafields.spr.reviews }}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="ProductJson-{{ product.id }}">
  {{ product | json }}
</script>

<script>
  // Uitgebreide logica voor variant selectie, prijs updates, UI updates, etc.
  document.addEventListener('DOMContentLoaded', function() {
    const productContainer = document.querySelector('.product-single');
    if (!productContainer) return;

    const productFormElement = productContainer.querySelector('.product-form');
    if (!productFormElement) return;

    const productJsonElement = productContainer.querySelector('[id^="ProductJson-"]');
    const productData = productJsonElement ? JSON.parse(productJsonElement.textContent) : null;
    if (!productData) return;

    const variantDataElement = productContainer.querySelector('[data-variant-json]');
    const variantData = variantDataElement ? JSON.parse(variantDataElement.dataset.variantJson) : productData.variants;


    const mainImage = productContainer.querySelector('#ProductPhotoImg');
    const thumbnailsList = productContainer.querySelector('.product-single__thumbnails');
    const priceElement = productContainer.querySelector('.product__price-value');
    const comparePriceElement = productContainer.querySelector('.product__price--compare');
    const saleBadgeElement = productContainer.querySelector('.product__price--sale-badge');
    const skuElement = productContainer.querySelector('.product-single__sku');
    const addToCartButton = productFormElement.querySelector('.product-form__cart-submit');
    const addToCartText = addToCartButton ? addToCartButton.querySelector('.add-to-cart-text') : null;
    const spinner = addToCartButton ? addToCartButton.querySelector('.product-form__spinner') : null;
    const quantityInput = productFormElement.querySelector('.quantity-selector__input');
    const quantityMinus = productFormElement.querySelector('.quantity-selector__button--minus');
    const quantityPlus = productFormElement.querySelector('.quantity-selector__button--plus');
    const hiddenVariantSelect = productFormElement.querySelector('#ProductSelect');

    let currentVariant = variantData.find(v => v.id == hiddenVariantSelect.value) || variantData[0];

    function updateVariantUI() {
      if (!currentVariant) return;

      // Update main image
      if (mainImage && currentVariant.featured_image) {
        mainImage.src = Shopify.Image.getSizedImageUrl(currentVariant.featured_image.src, '1024x1024');
        mainImage.alt = currentVariant.featured_image.alt;
        if (mainImage.dataset.zoomUrl) {
            mainImage.dataset.zoomUrl = Shopify.Image.getSizedImageUrl(currentVariant.featured_image.src, '2048x2048');
        }
        // Update active thumbnail
        if (thumbnailsList) {
          thumbnailsList.querySelectorAll('.product-single__thumbnail-item').forEach(thumb => {
            thumb.classList.remove('is-active');
            if (thumb.dataset.thumbnailId == currentVariant.featured_image.id) {
              thumb.classList.add('is-active');
            }
          });
        }
      } else if (mainImage && productData.featured_image && !currentVariant.featured_image) {
         // Fallback to product's featured image if variant has none
        mainImage.src = Shopify.Image.getSizedImageUrl(productData.featured_image.src, '1024x1024');
        mainImage.alt = productData.featured_image.alt;
         if (mainImage.dataset.zoomUrl) {
            mainImage.dataset.zoomUrl = Shopify.Image.getSizedImageUrl(productData.featured_image.src, '2048x2048');
        }
      }


      // Update price
      if (priceElement) {
        priceElement.innerHTML = Shopify.formatMoney(currentVariant.price, window.Shopify.currency.money_format);
      }
      if (comparePriceElement) {
        if (currentVariant.compare_at_price > currentVariant.price) {
          comparePriceElement.innerHTML = Shopify.formatMoney(currentVariant.compare_at_price, window.Shopify.currency.money_format);
          comparePriceElement.style.display = 'inline';
          if(saleBadgeElement) saleBadgeElement.style.display = 'inline-block';
        } else {
          comparePriceElement.style.display = 'none';
          if(saleBadgeElement) saleBadgeElement.style.display = 'none';
        }
      }

      // Update SKU
      if (skuElement) {
        skuElement.textContent = currentVariant.sku ? `SKU: ${currentVariant.sku}` : '';
      }

      // Update Add to Cart button
      if (addToCartButton && addToCartText) {
        if (currentVariant.available) {
          addToCartButton.disabled = false;
          addToCartText.textContent = Shopify.translation.addToCart || 'Add to Cart';
        } else {
          addToCartButton.disabled = true;
          addToCartText.textContent = Shopify.translation.soldOut || 'Sold Out';
        }
      }
      // Update hidden select
      hiddenVariantSelect.value = currentVariant.id;
    }

    // Event listeners for option selectors (radio buttons)
    const optionRadios = productFormElement.querySelectorAll('[data-option-value]');
    optionRadios.forEach(radio => {
      radio.addEventListener('change', () => {
        const selectedOptions = [];
        productFormElement.querySelectorAll('.product-form__option').forEach((optionSet, index) => {
          const checkedRadio = optionSet.querySelector('input[type="radio"]:checked');
          if (checkedRadio) {
            selectedOptions[index] = checkedRadio.value;
          }
        });

        currentVariant = variantData.find(variant => {
          return selectedOptions.every((option, index) => {
            return variant.options[index] === option;
          });
        });
        updateVariantUI();
      });
    });

    // Thumbnail click logic
    if (thumbnailsList) {
      thumbnailsList.querySelectorAll('.product-single__thumbnail-link').forEach(link => {
        link.addEventListener('click', function(e) {
          e.preventDefault();
          const imageId = this.dataset.imageId;
          // Update main image (could also find variant associated with this image if needed)
          mainImage.src = this.href; // href is already sized to 1024x1024
          if (mainImage.dataset.zoomUrl) {
            mainImage.dataset.zoomUrl = this.href.replace('1024x1024', '2048x2048'); // Adjust zoom URL
          }
          // Update active state
          thumbnailsList.querySelectorAll('.product-single__thumbnail-item').forEach(item => item.classList.remove('is-active'));
          this.closest('.product-single__thumbnail-item').classList.add('is-active');
        });
      });
    }

    // Quantity selector logic
    if (quantityInput && quantityMinus && quantityPlus) {
      quantityMinus.addEventListener('click', () => {
        let currentVal = parseInt(quantityInput.value);
        if (currentVal > 1) {
          quantityInput.value = currentVal - 1;
        }
      });
      quantityPlus.addEventListener('click', () => {
        quantityInput.value = parseInt(quantityInput.value) + 1;
      });
    }

    // Product Tabs Logic
    const tabLinks = productContainer.querySelectorAll('.product-tabs__link');
    const tabPanels = productContainer.querySelectorAll('.product-tabs__panel');
    const reviewsTabLink = productContainer.querySelector('a[href="#tab-reviews"]');
    const reviewsCountSpan = reviewsTabLink ? reviewsTabLink.querySelector('.product-reviews-count') : null;

    if (tabLinks.length > 0 && tabPanels.length > 0) {
      tabLinks.forEach(link => {
        link.addEventListener('click', function(e) {
          e.preventDefault();
          const targetPanelId = this.getAttribute('href');

          tabLinks.forEach(l => {
            l.classList.remove('is-active');
            l.setAttribute('aria-selected', 'false');
          });
          this.classList.add('is-active');
          this.setAttribute('aria-selected', 'true');

          tabPanels.forEach(panel => {
            if (`#${panel.id}` === targetPanelId) {
              panel.classList.add('is-active');
            } else {
              panel.classList.remove('is-active');
            }
          });
        });
      });
    }

    // Update review count (basic, Shopify Reviews app might do this differently)
    if (reviewsCountSpan && window.SPR) { // Check if Shopify Product Reviews is available
        SPR.getProductReviews("{{product.id}}", function(data){
            if(data && data.reviews && data.reviews.length > 0){
                reviewsCountSpan.textContent = data.reviews.length;
            }
        });
    }


    // Form submission spinner
    if (productFormElement && addToCartButton && spinner && addToCartText) {
      productFormElement.addEventListener('submit', function() {
        addToCartText.classList.add('is-hidden');
        spinner.style.display = 'inline-block';
        addToCartButton.disabled = true; // Disable button during submission
        // Spinner will hide and text will restore on page reload or AJAX completion
      });
    }

    // Initial UI update
    updateVariantUI();
  });
</script>

<style>
/* Specifieke stijlen voor productpagina - DEZE WORDEN NU GENEGEERD EN VERPLAATST NAAR style.css */
</style>
