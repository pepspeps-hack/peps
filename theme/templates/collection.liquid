<div class="page-width">
  <div class="section-header text-center">
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="rte">
        {{ collection.description }}
      </div>
    {% endif %}
  </div>

  {%- liquid
    assign products_per_page = section.settings.products_per_page | default: 12
    assign products_per_row_desktop = section.settings.products_per_row_desktop | default: 4
    assign products_per_row_mobile = section.settings.products_per_row_mobile | default: 2

    assign grid_item_class = 'medium-up--one-' | append: products_per_row_desktop | replace: '4', 'quarter' | replace: '3', 'third' | replace: '2', 'half'
    if products_per_row_desktop == 5
        assign grid_item_class = 'medium-up--one-fifth'
    endif
    assign grid_item_class_mobile = 'small--one-' | append: products_per_row_mobile | replace: '2', 'half' | replace: '1', 'whole'
  -%}

  <div class="collection-header section-header text-center">
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="collection-description rte">
        {{ collection.description }}
      </div>
    {% endif %}
  </div>

  <div class="collection-toolbar">
    <div class="collection-toolbar__item collection-toolbar__item--filters">
      {% comment %} Filter knop voor mobiel/sidebar {% endcomment %}
      <button type="button" class="btn btn--secondary btn--small collection-filter-toggle" aria-expanded="false" aria-controls="CollectionFilters">
        {{ 'collections.filters.title' | t }}
      </button>
    </div>
    <div class="collection-toolbar__item collection-toolbar__item--sort">
      {%- render 'collection-sort-form' -%}
    </div>
    <div class="collection-toolbar__item collection-toolbar__item--count">
       {{ 'collections.general.items_with_count' | t: count: collection.products_count }}
    </div>
  </div>

  {% comment %} TODO: Filter sidebar implementatie {% endcomment %}
  <aside id="CollectionFilters" class="collection-filters" style="display:none;">
    <p>Filters komen hier...</p>
  </aside>


  {% paginate collection.products by products_per_page %}
    {% if collection.products.size > 0 %}
      <div class="product-grid grid grid--uniform">
        {% for product in collection.products %}
          <div class="grid__item {{ grid_item_class_mobile }} {{ grid_item_class }}">
            {% include 'product-card', product: product, class: 'collection-product-card' %}
          </div>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        {%- render 'pagination', paginate: paginate -%}
      {% endif %}
    {% else %}
      <p class="text-center">{{ 'collections.general.no_matches' | t }}</p>
    {% endif %}
  {% endpaginate %}
</div>

{% comment %} Stijlen specifiek voor de collectiepagina (verplaatst naar style.css) {% endcomment %}

{% comment %}
  Het 'product-card' snippet wordt gebruikt om elk product in de grid weer te geven.
  Het 'pagination' snippet wordt gebruikt voor paginering.
  Het 'collection-sort-form' snippet voor sorteren.
{% endcomment %}

{% schema %}
{
  "name": "Collection Page",
  "tag": "section",
  "class": "collection-page-section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "label": "Products per page",
      "default": 12
    },
    {
      "type": "select",
      "id": "products_per_row_desktop",
      "label": "Products per row (Desktop)",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4 (Recommended)" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "products_per_row_mobile",
      "label": "Products per row (Mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2 (Recommended)" }
      ],
      "default": "2"
    },
    {
        "type": "header",
        "content": "Filtering & Sorting"
    },
    {
        "type": "checkbox",
        "id": "enable_filtering",
        "label": "Enable filtering",
        "default": true,
        "info": "Requires tags on products for filters to appear."
    },
    {
        "type": "checkbox",
        "id": "enable_sorting",
        "label": "Enable sorting",
        "default": true
    }
  ]
}
{% endschema %}
